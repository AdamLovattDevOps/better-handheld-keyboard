#!/usr/bin/env bash
# Write the handheld-kbd-opacity KWin script.
#
# ONE writer, called by everything that needs the script to exist: the installer, the swap
# daemon, and the keyboard's opacity key. It used to be two — a static copy shipped by the
# installer and a generated one written by the daemon — which diverged: the static copy
# hardcoded its opacity and had no `var OP` line, so the opacity key silently patched
# nothing and every reload snapped the keyboard back to 0.72.
#
#   handheld-kbd-kwin-script [--opacity 0.72] [--hide-steam 0|1] [--out PATH]
#
# --hide-steam 0 leaves Steam's on-screen keyboard alone; the daemon only passes 1 once
# this keyboard has proven it can appear (see handheld-kbd-swap.sh).
#
# --mirror 1 makes the script drive the keyboard from Steam's OSK: when that window maps
# we call Show on the keyboard's DBus service, when it goes we call Hide. That replaced a
# 10Hz xwininfo/xprop poll in the daemon, which cost constant CPU and added up to 100ms to
# every summon.
set -uo pipefail

OUT="$HOME/.local/share/kwin/scripts/handheld-kbd-opacity/contents/code/main.js"
OP=""
HIDE_STEAM=1
MIRROR=""
REPORT=0        # 1 while the user is moving the keyboard by hand: report its geometry back
DOCK_OVERRIDE=""  # force docking off while the user is dragging, whatever the config says
NAME="Steam Input On-screen Keyboard"

while [ $# -gt 0 ]; do
    case "$1" in
        --opacity)    OP="${2:-}"; shift 2 ;;
        --hide-steam) HIDE_STEAM="${2:-1}"; shift 2 ;;
        --mirror)     MIRROR="${2:-0}"; shift 2 ;;
        --report)     REPORT="${2:-0}"; shift 2 ;;
        --dock)       DOCK_OVERRIDE="${2:-}"; shift 2 ;;
        --out)        OUT="${2:-$OUT}"; shift 2 ;;
        --print)      OUT="/dev/stdout"; shift ;;
        *) echo "handheld-kbd-kwin-script: unknown argument '$1'" >&2; exit 2 ;;
    esac
done

# Default to whatever the config says, so callers don't have to parse JSON themselves.
if [ -z "$OP" ]; then
    OP=$(python3 -c 'import json,os
try: print(float(json.load(open(os.path.expanduser("~/.config/handheld-kbd/config.json")))["opacity"]))
except Exception: print(0.72)' 2>/dev/null)
fi
case "$OP" in ''|*[!0-9.]*) OP=0.72 ;; esac

# Docking is decided in here, by KWin, because KWin is the only thing that knows the work
# area: logical pixels (so display scaling is already accounted for) minus the panels. A
# 1920x1200 panel at scale 1.5 is a 1280x800 desktop, and the Plasma panel takes a slice
# off the bottom of that — neither is visible from outside the compositor.
# PLACE: dock (we compute the bottom strip), custom (the rect the user chose), or none
# (they are dragging it right now — hands off). ONE authority for placement: this script.
# KWin window rules are deliberately not used to position the keyboard, because a Force or
# Remember rule and this script each keep re-asserting their own idea of where the window
# belongs — which is what made a dragged keyboard snap back a second later.
DOCK_CFG=$(python3 -c 'import json,os
try:
    d = json.load(open(os.path.expanduser("~/.config/handheld-kbd/config.json")))
except Exception:
    d = {}
g = d.get("geometry") or {}
frac = d.get("big_height_frac", 0.55) if d.get("start_big") else d.get("dock_height_frac", 0.42)
try:
    frac = float(frac)
except Exception:
    frac = 0.42
mode = d.get("position_mode", "bottom")
if mode == "free":
    place = "none"          # the user placed it and we could not read the rect: hands off
elif mode == "custom" and g.get("w") and g.get("h"):
    place = "custom"
else:
    place = "dock"
print(place, max(0.15, min(frac, 0.95)),
      int(g.get("x", 0)), int(g.get("y", 0)), int(g.get("w", 0)), int(g.get("h", 0)))' 2>/dev/null)
set -- $DOCK_CFG
PLACE="${1:-dock}"; FRAC="${2:-0.42}"; CX="${3:-0}"; CY="${4:-0}"; CW="${5:-0}"; CH="${6:-0}"
# An explicit --dock wins: free-move has to turn docking off even though the config still
# says "bottom", or the keyboard is dragged straight back the moment the user lets go.
# --dock 0 means the user is dragging: no placement at all until they finish.
case "$DOCK_OVERRIDE" in 0) PLACE="none" ;; 1) PLACE="dock" ;; esac
# A runtime fallback beats the config: the daemon sets this when the hardware-button remap
# could not be applied, and without honouring it here every regeneration of this script
# would turn mirroring back off while the button is still dead.
if [ -z "$MIRROR" ] && [ -f /tmp/handheld-kbd.mirror-fallback ]; then
    MIRROR=1
fi
if [ -z "$MIRROR" ]; then
    MIRROR=$(python3 -c 'import json,os
try: print(0 if json.load(open(os.path.expanduser("~/.config/handheld-kbd/config.json"))).get("mirror", True) is False else 1)
except Exception: print(1)' 2>/dev/null)
fi
case "$MIRROR" in 0|1) : ;; *) MIRROR=1 ;; esac
case "$PLACE" in dock|custom|none) : ;; *) PLACE=dock ;; esac
case "$FRAC" in ''|*[!0-9.]*) FRAC=0.42 ;; esac
for v in CX CY CW CH; do
    eval "val=\$$v"; case "$val" in ''|*[!0-9-]*) eval "$v=0" ;; esac
done

if [ "$HIDE_STEAM" = 1 ]; then
    STEAM_RULE="else if (cap.indexOf(\"$NAME\") !== -1) w.opacity = 0.0;"
else
    STEAM_RULE="// Steam's OSK left alone: this keyboard has not proven it can appear yet."
fi

[ "$OUT" = "/dev/stdout" ] || mkdir -p "$(dirname "$OUT")"
cat > "$OUT" <<EOF
// Better Handheld Keyboard KWin helper: (1) set our OSK's opacity + hide Steam's OSK,
// (2) keep the OSK visible above fullscreen windows (e.g. Chrome video fullscreen),
// (3) keep keyboard focus on the window the user was on when the OSK is summoned.
// Generated by handheld-kbd-kwin-script — edits here are overwritten.
var OP = $OP;
var MIRROR = $MIRROR;   // 1 = follow Steam's OSK (the device has no dedicated button)
var STEAM_OSK = "$NAME";
var REPORT = $REPORT;   // 1 = tell the keyboard where it ends up (free-move is on)
var PLACE = "$PLACE";  // "dock" | "custom" | "none" (the user is moving it by hand)
var FRAC = $FRAC;      // dock height as a fraction of the usable area
var CUSTOM = { x: $CX, y: $CY, width: $CW, height: $CH };
var demoted = {};   // internalId -> true : fullscreen windows WE dropped to keepBelow
var lastReal = null;   // most recent focusable window the user was on (for focus restore)

function isKbd(w){ return ("" + w.resourceClass).indexOf("handheld-kbd") !== -1; }

function focusable(w){
    // windows that can hold the user's typing focus: exclude our OSK and
    // non-activating surfaces (panels/docks, desktop, OSD, notifications).
    if (!w) return false;
    if (isKbd(w)) return false;
    if (w.dock || w.desktopWindow || w.onScreenDisplay || w.notification) return false;
    return true;
}

function setOp(w){
    try {
        var c = "" + w.resourceClass;
        var cap = "" + w.caption;
        if (c.indexOf("handheld-kbd") !== -1) w.opacity = OP;
        $STEAM_RULE
    } catch(e){}
}

// GTK hide() destroys the OSK's Wayland surface, so a present, non-minimized
// handheld-kbd window means the keyboard is currently shown.
function kbdShown(){
    var list = workspace.windowList();
    for (var i = 0; i < list.length; i++)
        if (isKbd(list[i]) && !list[i].minimized) return true;
    return false;
}

// A fullscreen window sits in KWin's ActiveLayer, above the OSK's keep-above
// AboveLayer, so it covers the keyboard. keepBelow is evaluated before
// activeFullScreen, so dropping the fullscreen window to keepBelow (BelowLayer)
// lets the OSK float on top. Restore it when the OSK hides / leaves fullscreen.
function applyStack(){
    try {
        var shown = kbdShown();
        var list = workspace.windowList();
        for (var i = 0; i < list.length; i++){
            var w = list[i];
            if (isKbd(w)) continue;
            var id = "" + w.internalId;
            if (shown && w.fullScreen){
                if (!w.keepBelow){ w.keepBelow = true; demoted[id] = true; }
            } else if (demoted[id]){
                w.keepBelow = false;
                delete demoted[id];
            }
        }
    } catch(e){}
}

// Dock the keyboard along the bottom of the usable area of whichever screen it is on.
// clientArea(MaximizeArea) is in logical pixels and already excludes panels, so this is
// right at any resolution, any scale factor, and with a panel of any size on any edge.
var placing = false;   // re-entry guard: we resize the window inside its own signal
var placedCustom = {};  // a custom spot is applied once per window, never re-asserted
function dockKbd(w){
    if (PLACE === "none" || !isKbd(w) || placing) return;
    placing = true;
    if (PLACE === "custom") {
        if (placedCustom["" + w.internalId]) { placing = false; return; }
        placedCustom["" + w.internalId] = true;
        try {
            var cg = w.frameGeometry;
            cg.x = CUSTOM.x; cg.y = CUSTOM.y;
            cg.width = CUSTOM.width; cg.height = CUSTOM.height;
            w.frameGeometry = cg;
        } catch(e){}
        placing = false;
        return;
    }
    try {
        var area = workspace.clientArea(KWin.MaximizeArea, w);
        var h = Math.max(120, Math.round(area.height * FRAC));
        var geo = w.frameGeometry;
        geo.x = area.x; geo.width = area.width;
        geo.height = h; geo.y = area.y + area.height - h;
        w.frameGeometry = geo;
        // The client has a minimum size, so it may come back taller than we asked. Re-anchor
        // to whatever it actually became, or the extra height hangs off the bottom edge.
        var got = w.frameGeometry;
        if (got.height !== h || got.width !== area.width) {
            got.x = area.x;
            got.y = area.y + area.height - got.height;
            w.frameGeometry = got;
        }
    } catch(e){}
    placing = false;
}

function isSteamOsk(w){ return ("" + w.caption).indexOf(STEAM_OSK) !== -1; }

// Drive our keyboard straight from the compositor's own window events — no polling, and
// the call goes out in the same event as the window mapping, so the keyboard appears
// immediately rather than up to a poll interval later.
function callKbd(method){
    try {
        callDBus("org.handheld.Keyboard", "/org/handheld/Keyboard",
                 "org.handheld.Keyboard", method);
    } catch(e){}
}

function watch(w){
    try { w.fullScreenChanged.connect(applyStack); w.minimizedChanged.connect(applyStack); } catch(e){}
    if (REPORT && isKbd(w)) watchGeometry(w);
    // Keep it pinned: GTK can settle on a different height slightly after we place it
    // (the suggestion row, a font metric), which would otherwise leave the keyboard
    // floating short of the bottom edge until something else moved it.
    // Only the dock re-asserts itself. A custom spot is placed once and then left alone,
    // so the keyboard behaves like a normal window you happened to put there.
    if (PLACE === "dock" && isKbd(w)) {
        try { w.frameGeometryChanged.connect(function(){ dockKbd(w); }); } catch(e){}
    }
}

// While the user is dragging the keyboard, tell it where it actually is. A Wayland client
// cannot ask, and a KWin "Remember" rule is not written back to kwinrulesrc until the
// window closes — reading that file mid-session returns the previous forced rect, which is
// why finishing a move used to snap the keyboard back to where it started.
function reportGeometry(w){
    try {
        var g = w.frameGeometry;
        callDBus("org.handheld.Keyboard", "/org/handheld/Keyboard",
                 "org.handheld.Keyboard", "SetGeometry",
                 "" + g.x + "," + g.y + "," + g.width + "," + g.height);
    } catch(e){}
}

function watchGeometry(w){
    // Signal names have moved around between KWin versions, so connect to whichever exist
    // rather than assuming. Each is wrapped: one missing signal must not stop the others.
    var signals = ["frameGeometryChanged", "geometryChanged", "moveResizedChanged",
                   "interactiveMoveResizeFinished", "interactiveMoveResizeStepped"];
    var connected = 0;
    for (var i = 0; i < signals.length; i++) {
        try {
            if (w[signals[i]] && w[signals[i]].connect) {
                w[signals[i]].connect(function(){ reportGeometry(w); });
                connected++;
            }
        } catch(e){}
    }
    print("HHKBD watching geometry via " + connected + " signal(s)");
    // Deliberately NOT reporting here. Seeding the current rect means that if the drag
    // emits no signal we still hold a value — the pre-drag dock position — and finishing
    // the move would "save" that and snap the keyboard back to the dock.
}
function onAdded(w){
    setOp(w); watch(w); dockKbd(w); applyStack();
    if (MIRROR && isSteamOsk(w)) callKbd("Show");
    // When our OSK maps, the summon (touch gesture / map) may have shifted focus.
    // Re-assert the window the user was on so typed keys land there. keepBelow keeps
    // a demoted fullscreen window below the OSK even once it is active again.
    if (isKbd(w) && lastReal) {
        // only re-activate if focus actually moved, so we don't needlessly re-raise the
        // window and disturb the text caret when the summon didn't defocus it.
        try { if (workspace.activeWindow !== lastReal) workspace.activeWindow = lastReal; } catch(e){}
    }
}

workspace.windowActivated.connect(function(w){ if (focusable(w)) lastReal = w; });
workspace.windowList().forEach(function(w){
    setOp(w); watch(w);
    // Existing windows: in custom placement, mark as already placed so a script reload
    // leaves them untouched. Docking still re-asserts, because that is ours to compute.
    if (PLACE === "custom") placedCustom[""+w.internalId] = true;
    dockKbd(w);
});
workspace.windowAdded.connect(onAdded);
workspace.windowRemoved.connect(function(w){
    applyStack();
    if (MIRROR && isSteamOsk(w)) callKbd("Hide");
});
applyStack();
EOF
